# Database Configuration (PostgreSQL on port 3779 with geomobile137 database)
DATABASE_URL=postgres://postgres:YOUR_SECURE_PASSWORD@127.0.0.1:3779/geomobile137?sslmode=disable
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3779
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_SECURE_PASSWORD
DATABASE_NAME=geomobile137

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8080

# Authentication
AUTH_ENABLED=true
ALLOW_SIGNUP=true
ALLOW_REGISTRATION=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
ALLOWED_FORMATS=geojson,shp,dxf,kml,gpx,pdf,jpg,png

# Geospatial Configuration
POSTGIS_ENABLED=true
COORDINATE_SYSTEM=EPSG:4326

# Multi-Agent Configuration
ENABLE_AGENTS=true
AGENT_LOG_LEVEL=info
GEODATA_AGENT_ENABLED=true
AUDIT_AGENT_ENABLED=true
DEPLOY_AGENT_ENABLED=true
MOBILE_AGENT_ENABLED=true
CREATIVE_AGENT_ENABLED=true
GOVERNANCE_AGENT_ENABLED=true

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8080

# Monitoring and Analytics
MONITORING_ENABLED=true
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Email Configuration (optional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@cadastre-ia.local

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Performance Configuration
MAX_CONCURRENT_CONNECTIONS=100
CONNECTION_POOL_SIZE=20
CACHE_TTL=3600

# Feature Flags
FEATURE_OFFLINE_SYNC=true
FEATURE_CRDT_SYNC=true
FEATURE_BULK_IMPORT=true
FEATURE_DRONE_INTEGRATION=false
FEATURE_ML_CONFLICT_RESOLUTION=false
